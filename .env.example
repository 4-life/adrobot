# Tracker adapter (app/tracker/factory.py): "keitaro", or "fake" for local testing with
# in-memory sample data (20 offers, 3 campaigns; nothing reaches Keitaro; reset on API restart).
TRACKER="keitaro"

# Keitaro: the panel's address without a path (AdRobot adds /admin_api/v1).
KEITARO_URL="https://tracker.example.com"
KEITARO_API_KEY=""

# Campaign defaults
GEO_REDIRECT_URL="https://google.com"
# MVP only, empty in production: new campaign names (prefix + N), the table's default search,
# and whose streams Fetch streams reads. Empty: Fetch streams reads the campaign list only.
CAMPAIGN_NAME_PREFIX="test_name_campaign"

# Postgres (local)
POSTGRES_USER="adrobot"
POSTGRES_PASSWORD="adrobot"
POSTGRES_DB="adrobot"

# Ports (bound to 127.0.0.1)
API_PORT=8000
DASHBOARD_PORT=3000
